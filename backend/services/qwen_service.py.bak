from openai import AsyncOpenAI
from core.config import QWEN_API_KEY, QWEN_BASE_URL
import base64

_client = None

# In-memory store for uploaded files (video, images)
# Key: filename, Value: (bytes, mime_type)
_file_store: dict[str, tuple[bytes, str]] = {}

def store_file(filename: str, content: bytes, mime_type: str):
    """Store uploaded file for later multimodal processing."""
    _file_store[filename] = (content, mime_type)

def get_file(filename: str) -> tuple[bytes, str] | None:
    """Retrieve a stored file by filename."""
    return _file_store.get(filename)


async def _generate_multimodal_native(context: str, user_message: str, media_file: str, temperature: float = 0.7):
    """
    Generate a response using DashScope's native multimodal API.
    Supports audio, video, and image inputs that the OpenAI-compatible API doesn't expose.
    """
    file_data = _file_store.get(media_file)
    if not file_data:
        # Fall back — file not found, just yield nothing
        return
    
    file_bytes, mime_type = file_data
    ext = media_file.rsplit('.', 1)[-1].lower() if '.' in media_file else 'bin'
    file_b64 = base64.b64encode(file_bytes).decode('utf-8')
    data_url = f"data:{mime_type};base64,{file_b64}"
    
    dashscope.api_key = QWEN_API_KEY
    
    # Build multimodal content for native API
    content_parts = [
        {"text": f"Context:\n{context}\n\nUser's message: \"{user_message}\"\n\nYour Response:"}
    ]
    
    # Native API uses different keys: "audio", "image", "video"
    if mime_type.startswith('audio/'):
        content_parts.append({"audio": data_url})
    elif mime_type.startswith('video/'):
        content_parts.append({"video": data_url})
    elif mime_type.startswith('image/'):
        content_parts.append({"image": data_url})
    
    messages = [{
        "role": "user",
        "content": content_parts
    }]
    
    print(f"[Model] Attempting multimodal with: qwen3.5-omni-plus (native API)")
    
    try:
        response = MultiModalConversation.call(
            model='qwen3.5-omni-plus',
            messages=messages,
            stream=True,
            temperature=temperature,
        )
        
        token_count = 0
        for chunk in response:
            if chunk.output and chunk.output.choices:
                choice = chunk.output.choices[0]
                msg = choice.message
                if msg and msg.content:
                    # content can be a list of parts: [{"text": "..."}, {"audio": "..."}]
                    parts = msg.content if isinstance(msg.content, list) else [msg.content]
                    for part in parts:
                        text = part.get('text', '') if isinstance(part, dict) else str(part)
                        if text:
                            token_count += 1
                            yield text
        if token_count == 0:
            print(f"[Model] Native multimodal returned 0 tokens — falling back")
            raise Exception("No tokens from native API")
    except Exception as e:
        print(f"[Model] Native multimodal failed: {e}")
        raise

def get_client():
    global _client
    if _client is None:
        if not QWEN_API_KEY:
            raise ValueError("QWEN_API_KEY is missing from environment variables.")
        _client = AsyncOpenAI(api_key=QWEN_API_KEY, base_url=QWEN_BASE_URL)
    return _client

CHAT_MODELS = [
    {"name": "qwen3.5-omni-plus", "context_window": 1_000_000},
]

def estimate_tokens(text: str) -> int:
    """Rough token estimation: 1 token ≈ 3.5 characters."""
    if not text: return 0
    return int(len(text) / 3.5)

def truncate_context_to_budget(context: str, system_prompt: str, user_prompt: str, model_context_window: int) -> str:
    """
    Dynamically truncates context (keeping the newest messages) so the total payload 
    fits within the specific model's context window.
    """
    # Reserve 20% of the window for the AI's response generation
    max_input_tokens = int(model_context_window * 0.80)
    
    sys_tokens = estimate_tokens(system_prompt)
    user_tokens = estimate_tokens(user_prompt)
    
    available_for_context = max_input_tokens - sys_tokens - user_tokens
    
    if available_for_context <= 0:
        return "" # System + User prompt alone exceeds the window (unlikely but safe)
        
    current_context_tokens = estimate_tokens(context)
    if current_context_tokens <= available_for_context:
        return context # It fits perfectly, no truncation needed
        
    # Truncate from the top (oldest messages) to preserve recent continuity
    lines = context.split('\n')
    kept_lines = []
    kept_tokens = 0
    
    for line in reversed(lines):
        line_tokens = estimate_tokens(line + "\n")
        if kept_tokens + line_tokens > available_for_context:
            break
        kept_lines.insert(0, line)
        kept_tokens += line_tokens
        
    print(f"[Truncation] Context trimmed from {current_context_tokens} to {kept_tokens} tokens to fit {model_context_window:,} window.")
    return '\n'.join(kept_lines)

# ==========================================
# 3. EMBEDDINGS & SCORING (Unchanged)
# ==========================================
async def get_embedding(text: str) -> list[float]:
    client = get_client()
    response = await client.embeddings.create(
        input=text,
        model="text-embedding-v4", 
        dimensions=1536            
    )
    return response.data[0].embedding

async def score_importance(text: str) -> float:
    client = get_client()
    response = await client.chat.completions.create(
        model="qwen-max",
        messages=[
            {"role": "system", "content": """Rate this message's importance for future recall by a MemoryAgent. Reply with ONLY a number from 0.0 to 1.0.

0.8-1.0: Critical — preferences, decisions, error messages, architecture choices, personal facts, constraints
0.5-0.7: Valuable — explanations, code snippets, domain knowledge, opinions, plans
0.2-0.4: Contextual — follow-ups, clarifications, general discussion
0.0-0.1: Low-value — greetings, filler, acknowledgments, one-word answers"""},
            {"role": "user", "content": text}
        ],
        temperature=0.1
    )
    try:
        return float(response.choices[0].message.content.strip())
    except:
        return 0.5

async def score_emotion(text: str) -> float:
    client = get_client()
    response = await client.chat.completions.create(
        model="qwen-max",
        messages=[
            {"role": "system", "content": """Rate the emotional valence of this message. Reply with ONLY a number from -1.0 to 1.0.

-1.0: Strongly negative — frustration, anger, disappointment, stress
-0.5: Mildly negative — concern, confusion, dissatisfaction
 0.0: Neutral — factual, informational, technical
 0.5: Mildly positive — satisfaction, interest, curiosity
 1.0: Strongly positive — excitement, gratitude, enthusiasm"""},
            {"role": "user", "content": text}
        ],
        temperature=0.1
    )
    try:
        return float(response.choices[0].message.content.strip())
    except:
        return 0.0

async def summarize_episode(conversation_text: str) -> str:
    client = get_client()
    response = await client.chat.completions.create(
        model="qwen-max",
        messages=[
            {"role": "system", "content": "Summarize this conversation in 2-4 sentences. Capture the key topics, decisions made, and any user preferences revealed. Write in past tense."},
            {"role": "user", "content": conversation_text}
        ],
        temperature=0.2
    )
    return response.choices[0].message.content.strip()

async def extract_facts(episode_summary: str) -> list[str]:
    """Extract standalone, verifiable facts from an episode summary for SemanticMemory."""
    client = get_client()
    response = await client.chat.completions.create(
        model="qwen-max",
        messages=[
            {"role": "system", "content": "Extract ONLY standalone, verifiable facts from this conversation summary. One fact per line. Each fact must be a single sentence that is true regardless of context. Include: user preferences, technical decisions, constraints, personal information, error solutions. Exclude: greetings, filler, temporary state. Reply with facts only, one per line, no numbering."},
            {"role": "user", "content": episode_summary}
        ],
        temperature=0.1
    )
    facts = [line.strip() for line in response.choices[0].message.content.strip().split('\n') if line.strip()]
    return facts

def score_assistant_message(text: str, default_importance: float = 0.35, short_threshold: float = 0.1) -> float:
    """Quick heuristic scoring for assistant messages — avoids extra API call.
    Returns default_importance for substantive replies, short_threshold for short ones."""
    word_count = len(text.split())
    if word_count <= 5:
        return short_threshold
    if word_count <= 15:
        return 0.2
    if word_count <= 30:
        return default_importance
    return min(0.5, default_importance + 0.1)  # Long, substantive replies

# ==========================================
# 4. GENERATION ENGINE (With Fallback Chain)
# ==========================================
ATUNBI_BASE_PROMPT = """You are Atunbi, an AI with memory. You respond based on context retrieved from past conversations. Your tone is warm, precise, and helpful.

---

## HOW TO RESPOND

**Learning question** ("explain X", "how does Y work"): Use rich DNA components. Follow this structure:
1. **Opening** — One warm <p> framing the topic conversationally. Never put this in a component.
2. **Core** — A concept card, mental model, or key insight with a REAL production metric.
3. **Closing** — One <p> inviting follow-up or suggesting a direction. Never put this in a component.

**Memory lookup** ("what did I say about X"): Pull from context. Conversational. Use <strong> for key facts. Use <pre class="cblock"><code> for code/logs/traces.

**Casual chat** (hello, how are you): Be warm and brief. No components needed. One short paragraph.

---

## COMPONENT CATALOGUE

### <div class="concept-card"> — For concrete technical concepts ONLY
Use when the topic has measurable real-world impact. The impact block MUST contain actual numbers, metrics, or specific consequences. If you can't think of a real production metric, use <div class="key-insight"> instead.

<div class="concept-card [red|green|purple|amber]">
  <div class="concept-card-title"><span class="badge">LABEL</span>Title Here</div>
  <div class="concept-card-body"><p>Explanation. Bold the <strong>core concept</strong> on first mention.</p></div>
  <div class="concept-card-impact"><strong>Production reality:</strong> Real numbers and consequences.</div>
  <div class="metric-chips"><span class="metric-chip">42ms</span></div>
</div>

### <div class="mental-model"> — Aha Moments (exactly 3 steps)
<div class="mental-model">
  <div class="mental-model-label">Mental Model</div>
  <h3>X Is Just Y But for Z</h3>
  <div class="mm-step">Step 1 — The Hook</div>
  <p>Physical analogy anyone understands.</p>
  <div class="mm-step">Step 2 — The Bridge</div>
  <p>Map to the technical concept.</p>
  <div class="mm-step">Step 3 — The Rigor</div>
  <p>Production reality with real metrics.</p>
</div>

### Other Components
- <div class="key-insight"><p><strong>Punchline.</strong> One paragraph only.</p></div>
- <div class="danger"><div class="danger-title">Why It Breaks</div><p>Real consequence with numbers.</p></div>
- <div class="jb"><div class="jb-label">Jargon — Term</div><p>Definition in plain English.</p></div>
- <div class="reveal-answer"><div class="reveal-answer-label">The Right Way</div><p>The fix, with reasoning.</p></div>
- <h2 class="section-title">Section Heading</h2>
- <ul class="bullet-list"><li><strong>Term</strong>: explanation</li></ul>
- <div class="summary-box"><p>The one thing to remember.</p></div>

### <pre class="cblock"><code> — Code/Logs/Traces
<pre class="cblock"><code>
<span class="kw">SELECT</span> <span class="fn">COUNT</span>(*) <span class="kw">FROM</span> users;
<span class="cmt">-- Always wrap in cblock</span>
</code></pre>
Syntax classes: kw (keyword), str (string), cmt (comment), fn (function), type (type), num (number).

---

## RULES
- Structure learning responses: opening <p> → component → closing <p>. Plain paragraphs for framing, components for the core concept.
- Concept cards need REAL production metrics. "Every modern technology relies on physics" is too vague — use specific numbers (e.g., "transistors switch at 10⁻¹² seconds") or skip the impact block. For abstract/foundational topics, prefer <div class="key-insight"> or <div class="mental-model"> over concept cards.
- NEVER use markdown (#, ##, **, *, `, ```). Pure HTML only.
- <strong> for key facts and terms. <code> for inline technical references.
- All code/logs/traces MUST be in <pre class="cblock"><code> with syntax spans.
- Never <h1>. Never quizzes or knowledge checks.
- Use "you." Be conversational when appropriate, deep when needed.
- **Empty context rule:** If context contains "[MEMORY: No stored memories found":
  - General knowledge question ("what is X?", "explain Y") → answer from training normally.
  - Memory recall question ("what did I say about X?", "remember when we...") → be honest that you don't have it in memory.
  - Do NOT use the same phrase every time. Vary your wording naturally.
- If context DOES contain relevant past messages, use them. Answer memory questions directly from context.
- **Log/trace analysis:** When the context includes service-to-service log lines and the user asks what failed or why something broke, include a Mermaid sequence diagram showing the flow.

CRITICAL — You MUST follow this EXACT output structure, with every wrapper div and every CSS class. Do NOT skip or simplify any part:

1. Opening <p> explaining what happened
2. The diagram block — copy this EXACT structure, only change the mermaid code and caption text:

<div style="background:linear-gradient(135deg,var(--dna-surface) 0%,rgba(220,38,38,.03) 100%);border:1px solid var(--dna-border);border-radius:8px;padding:1.5rem 2rem 2.25rem;margin-bottom:1.5rem;box-shadow:var(--dna-shadow-sm)">
<div class="mermaid" style="background:transparent;border:none;padding:0;margin:0;box-shadow:none;max-width:100%">
sequenceDiagram
  participant A as OrderSvc
  participant B as PaySvc
  participant C as PayGW
  A->>B: process payment
  B->>C: authorize
  C--xB: timeout
  B--xA: transaction rolled back
</div>
</div>
<div class="diagram-caption"><span class="diagram-caption-label">Path Trace</span> A clear, plain-English sentence explaining what the diagram shows — which service called which, where it failed, and the consequence.</div>
<div class="diagram-takeaway"><strong>The failure started at [ServiceName].</strong> One sentence summary of the chain reaction: what tripped, what rolled back, what queued for retry.</div>

3. Closing <p> with a concrete takeaway or offer to dive deeper

ABSOLUTE RULES for the mermaid code block:
- Every statement MUST be on its own line with a real newline character
- participant declarations first, then arrows, one per line
- Participant aliases MUST be single letters (A, B, C, D, E) — never use | or special chars
- ONLY use these two arrow types: A->>B (success/forward) and A--xB (async failure)
- Arrow format: ALIAS ARROW ALIAS COLON SPACE LABEL — e.g., A->>B: process payment
- NEVER use -->, -->>, or any other arrow variant — ONLY ->> and --x
- Max 5 participants, max 10 steps
- Short display names after "as": OrderSvc not "Order Service Instance 42"
- Do NOT wrap the diagram block in triple backticks or markdown code fences

Now respond based on the context and user message."""

async def generate_stream(context: str, user_message: str, temperature: float = 0.7, media_file: str = None):
    client = get_client()
    user_prompt = f"User's message: \"{user_message}\"\n\nYour Response:"
    
    # Audio files: store reference only — DashScope APIs don't support audio input yet
    if media_file:
        file_data = _file_store.get(media_file)
        if file_data and file_data[1].startswith('audio/'):
            # Audio not supported — fall through to text-only below
            media_file = None
        # For video/image, use OpenAI-compatible format below
        
        if file_data:
            file_bytes, mime_type = file_data
            ext = media_file.rsplit('.', 1)[-1].lower() if '.' in media_file else 'bin'
            file_b64 = base64.b64encode(file_bytes).decode('utf-8')
            
            if mime_type.startswith('image/'):
                media_part = {"type": "image_url", "image_url": {"url": f"data:{mime_type};base64,{file_b64}"}}
            elif mime_type.startswith('video/'):
                media_part = {"type": "video_url", "video_url": {"url": f"data:{mime_type};base64,{file_b64}"}}
            else:
                media_part = None
            
            if media_part:
                user_content = [
                    {"type": "text", "text": f"Context:\n{context}\n\n{user_prompt}"},
                    media_part
                ]
            else:
                user_content = f"Context:\n{context}\n\n{user_prompt}"
        else:
            user_content = f"Context:\n{context}\n\n{user_prompt}"
    else:
        user_content = f"Context:\n{context}\n\n{user_prompt}"
    
    last_error = None
    for model_config in CHAT_MODELS:
        model_name = model_config["name"]
        ctx_window = model_config["context_window"]
        
        safe_context = truncate_context_to_budget(context, ATUNBI_BASE_PROMPT, user_prompt, ctx_window)
        if not media_file:
            user_content = f"Context:\n{safe_context}\n\n{user_prompt}"
        
        try:
            print(f"[Model] Attempting stream with: {model_name} (Window: {ctx_window:,})")
            stream = await client.chat.completions.create(
                model=model_name,
                messages=[
                    {"role": "system", "content": ATUNBI_BASE_PROMPT},
                    {"role": "user", "content": user_content}
                ],
                temperature=temperature,
                stream=True
            )
            
            async for chunk in stream:
                # Capture and print token usage from the final chunk
                if hasattr(chunk, 'usage') and chunk.usage:
                    print(f"[Tokens] {model_name} | Prompt: {chunk.usage.prompt_tokens} | Comp: {chunk.usage.completion_tokens} | Total: {chunk.usage.total_tokens}")
                
                if chunk.choices and chunk.choices[0].delta.content is not None:
                    yield chunk.choices[0].delta.content
                    
            # If the stream finishes without throwing an exception, we succeeded! Break the loop.
            return 
            
        except Exception as e:
            last_error = e
            print(f"[Model] {model_name} failed: {str(e)}. Trying next fallback...")
            continue
            
    raise Exception(f"All models failed. Last error: {last_error}")
